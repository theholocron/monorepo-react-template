{
  "$schema": "https://turborepo.org/schema.json",
  "globalDependencies": ["pnpm-workspace.yaml", "tsconfig.json"],
  "tasks": {
    "build": {
      "inputs": ["src/**", "vite.config.ts", "tsconfig.json", "package.json"],
      "outputs": ["dist/**", "dist-app/**"],
      "dependsOn": ["^build"]
    },
    "build:storybook": {
      "inputs": ["src/**", ".storybook/**", "public/**"],
      "outputs": ["storybook-static/**"],
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "start:storybook": {
      "cache": false,
      "persistent": true
    },
    "test:cypress": {},
    "lint": {
      "inputs": ["src/**", "eslint.config.ts", "eslint.config.js"],
      "outputs": []
    },
    "test": {
      "inputs": ["src/**", ".storybook/**", "vitest.config.ts", "vitest.setup.ts", "package.json"],
      "outputs": ["test-report.junit.xml"],
      "dependsOn": ["^build"]
    },
    "test:coverage": {
      "inputs": ["src/**", ".storybook/**", "vitest.config.ts", "vitest.setup.ts", "package.json"],
      "outputs": ["coverage/**"],
      "dependsOn": ["^build"]
    },
    "test:storybook": {
      "inputs": ["src/**", ".storybook/**", "vitest.config.ts", "vitest.setup.ts", "package.json"],
      "outputs": ["coverage/**", "test-report.junit.xml"],
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "inputs": ["src/**", "tsconfig.json"],
      "outputs": [],
      "dependsOn": ["^build"]
    }
  }
}
